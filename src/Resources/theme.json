{
  "name": "AcademyTheme",
  "author": "Shopware Academy",
  "views": [
    "@Storefront",
    "@Plugins",
    "@AcademyTheme"
  ],
  "style": [
    "app/storefront/src/scss/overrides.scss",
    "@Storefront",
    "app/storefront/src/scss/base.scss"
  ],
  "script": [
    "@Storefront",
    "app/storefront/dist/storefront/js/academy-theme/academy-theme.js"
  ],
  "asset": [
    "@Storefront",
    "app/storefront/src/assets"
  ],
  "config": {
    "tabs": {
      "colours": {
        "label": {
          "en-GB": "Colours",
          "de-DE": "Farben"
        }
      }
    },
    "blocks": {
      "themeColours": {
        "label": {
          "en-GB": "Theme Colours",
          "de-DE": "Theme Farben"
        }
      }
    },
    "sections": {
      "mainNavigation": {
        "label": {
          "en-GB": "Main Navigation",
          "de-DE": "Hauptnavigation"
        }
      }
    },
    "fields": {
      "academy-main-navigation-background-color": {
        "label": {
          "en-GB": "Background Colour",
          "de-DE": "Hintergrundfarbe"
        },
        "type": "color",
        "value": "#ececec",
        "editable": true,
        "tab": "colours",
        "block": "themeColours",
        "section": "mainNavigation"
      }
    }
  }
}
